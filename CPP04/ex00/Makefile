# Name of the final executable generated by make.
NAME = RepetitiveWork

# C++ compiler and mandatory project flags (C++98 standard).
CXX = c++
CXXFLAGS = -Wall -Wextra -Werror -std=c++98

# Source files and their respective object files.
SRCS = main.cpp ClapTrap.cpp ScavTrap.cpp FragTrap.cpp
OBJS = $(SRCS:.cpp=.o)

# Default target: compiles everything.
all: $(NAME)

# Links the object files to generate the executable.
$(NAME): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $(NAME)

# Generic rule to compile any .cpp file into a .o file.
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Removes only the object files.
clean:
	rm -f $(OBJS)

# Removes both object files and the final executable.
fclean: clean
	rm -f $(NAME)

# Recompiles everything from scratch.
re: fclean all

# Specifies targets that are not actual files.
.PHONY: all clean fclean re
